# Copy to .env in this directory. Values here are read at startup by
# env_file.load_env(); real environment variables take precedence, so a
# systemd unit or container can still override any of them.
#
# .env is gitignored — these are per-deployment settings, not code.

# ── Catalog ───────────────────────────────────────────────────────────────
# The seo-catalog-generator install that owns product facts. Without this,
# every GPID lookup returns nothing and search results render with no
# supplier or product name — the failure is silent, so set it deliberately.
CATALOG_API_URL=https://seo-catalog-generator.com

# Which marketplace's products to resolve against.
CATALOG_MARKETPLACE=esorus

# Shared secret for /api/catalog/*. Must match CATALOG_API_KEY in the catalog
# app. Leave both unset only for local development: the /images endpoint will
# page out the entire catalog to anyone who asks.
CATALOG_API_KEY=

# Catalog's public/ directory, when it shares this machine's filesystem.
# Set it and index_images.py reads image files in place; leave it empty and
# every image is downloaded over HTTP instead — 66k requests and a full second
# copy on disk.
CATALOG_PUBLIC_DIR=/var/www/seo-catalog-generator.com/public

# Base URL the results page links images to. Defaults to CATALOG_API_URL.
CATALOG_ASSET_BASE=

# Seconds. The per-search resolve is deliberately short so a slow catalog
# never stalls a user's search; the manifest is a bulk call and needs far more.
CATALOG_API_TIMEOUT=3
CATALOG_MANIFEST_TIMEOUT=120
CATALOG_CACHE_TTL=3600

# ── This service's own API keys ───────────────────────────────────────────
# Require X-API-Key on /api/search. Unset leaves it open.
API_KEY=

# Require X-API-Key on /reindex. Unset leaves it open — and /reindex starts a
# multi-hour job, so set it anywhere reachable from outside.
REINDEX_API_KEY=
